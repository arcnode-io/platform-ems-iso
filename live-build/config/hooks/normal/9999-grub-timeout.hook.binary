#!/bin/sh
# Inject `set timeout=10` into grub.cfg so the boot menu auto-advances
# instead of waiting forever for keypress. Without this, the qemu
# integration test (and any headless boot) sits at the grub menu
# until the test fixture's 7-min poll times out.
#
# live-build assembles grub.cfg during the binary stage from templates
# that don't include a timeout directive. This *.hook.binary runs AFTER
# that assembly, with CWD = live-build/.
set -e

# Patch both BIOS + EFI grub configs. Hook runs with CWD = live-build/binary/
# staging dir (not live-build/), so paths are relative to binary/.
#
# Two patches:
#   1. set timeout=10            — auto-boot the default entry after 3s
#   2. serial/terminal config   — route grub UI through ttyS0 in addition to
#      the framebuffer. Without this, headless qemu (no display + no serial
#      grub) means grub's menu rendering goes nowhere and the kernel
#      never gets loaded even with the timeout set.
# Just timeout — DON'T touch terminal_output. Forcing serial as a grub
# output target broke boot on a real customer's hardware (USB boots to
# blinking cursor, no menu render). Default grub terminal_output=console
# works on real hardware AND in qemu (qemu's -vga std + -display none
# absorbs grub's VGA output silently while the kernel logs to ttyS0 via
# console=ttyS0 in the kernel cmdline).
# Default = the renamed Install entry (set below). Operator just waits
# 10s and gets an actual install. "Try in RAM (demo)" is a power-user
# alt for kicking the tires without writing to disk.
PREAMBLE='set timeout=10
set default="ARCNODE EMS — Install to disk"'

for CFG in boot/grub/grub.cfg boot/grub/x86_64-efi/grub.cfg; do
  [ -f "$CFG" ] || continue
  if ! grep -q '^set timeout=' "$CFG"; then
    # Prepend the whole preamble in one shot
    {
      printf '%s\n' "$PREAMBLE"
      cat "$CFG"
    } > "$CFG.new"
    mv "$CFG.new" "$CFG"
    echo "patched $CFG with timeout+serial preamble"
  fi
done

# Patch install entries (top-level + advanced submenu) to load our preseed.
# preseed.cfg provides sensible DEFAULTS — live-installer mode (copy
# squashfs vs fetch fresh), no mirror, en_US/us, hostname=arcnode — but
# d-i still runs its normal wizard so the operator picks disk, sets
# their own root password, adjusts locale/network etc. NOT unattended.
for CFG in boot/grub/grub.cfg boot/grub/install_start.cfg boot/grub/install.cfg \
           boot/grub/x86_64-efi/grub.cfg boot/grub/x86_64-efi/install_start.cfg \
           boot/grub/x86_64-efi/install.cfg; do
  [ -f "$CFG" ] || continue
  if grep -q '/install/vmlinuz' "$CFG" && ! grep -q 'preseed/file=' "$CFG"; then
    sed -i 's|linux\(.*\)/install/vmlinuz\(.*\)|linux\1/install/vmlinuz\2 preseed/file=/cdrom/install/preseed.cfg|' "$CFG"
    echo "patched $CFG install entries with preseed.cfg"
  fi
done

# Rebrand menuentry titles so operator sees ARCNODE-named choices
# instead of generic "Live system" / "Start installer". Default = the
# install entry (set in PREAMBLE above) — must match exactly.
for CFG in boot/grub/grub.cfg boot/grub/install_start.cfg \
           boot/grub/x86_64-efi/grub.cfg boot/grub/x86_64-efi/install_start.cfg; do
  [ -f "$CFG" ] || continue
  sed -i \
    -e 's|"Live system (amd64)"|"ARCNODE EMS — Try in RAM (demo)"|g' \
    -e "s|'Start installer'|\"ARCNODE EMS — Install to disk\"|g" \
    "$CFG"
done
