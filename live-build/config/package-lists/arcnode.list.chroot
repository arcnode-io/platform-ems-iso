# Packages installed into the live chroot at build time.
# Order grouped by role; comments cite *why* each one belongs in the image.
#
# Third-party-repo packages (timescale, neo4j, pgvector) are installed by
# hook 0015 — debootstrap's first apt-get update can't reach HTTPS repos
# without ca-certificates, which is itself in this list. Hook order works
# out: package list runs first (ca-certs lands), then numbered hooks.

# --- Base + boot ----------------------------------------------------
linux-image-amd64
firmware-linux
live-boot
live-config
systemd-sysv
openssh-server
ca-certificates
curl
gnupg
sudo
apt-transport-https
# Ollama's install.sh extracts a zstd-compressed tarball
zstd

# --- Data daemons (debian-native only here) ------------------------
postgresql-15

# --- Container runtime ----------------------------------------------
# docker.io from debian (smaller than docker-ce, no third-party repo).
# Compose v2 plugin installed via hook 0045.
docker.io

# --- App-stack runtime helpers --------------------------------------
python3
python3-venv
# uv installed via hook (no debian package yet)

# --- Optional but useful diagnostics --------------------------------
htop
iotop
lsof
tcpdump
