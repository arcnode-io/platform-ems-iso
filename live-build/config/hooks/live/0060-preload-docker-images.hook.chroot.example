#!/bin/sh
# Preload the docker images the appliance compose stack needs so first
# boot doesn't depend on a registry being reachable. Images pulled into
# /var/lib/docker which lives inside the squashfs.
#
# WHICH images: parsed from /opt/arcnode/compose/docker-compose.yaml at
# build time. We don't enumerate here because the list changes — single
# source of truth is the compose file.
set -e

COMPOSE=/opt/arcnode/compose/docker-compose.yaml
[ -f "$COMPOSE" ] || { echo "ERROR: $COMPOSE missing (run includes.chroot copy first)"; exit 1; }

# Reason: dockerd not running in chroot — start it briefly with vfs driver
# (overlayfs needs a real kernel mount, vfs does not). Slow but works.
dockerd --storage-driver vfs >/tmp/dockerd.log 2>&1 &
DOCKERD_PID=$!

for i in $(seq 1 30); do
  if docker info >/dev/null 2>&1; then break; fi
  sleep 1
done

# Pull every image referenced in the compose file
docker compose -f "$COMPOSE" pull --quiet

kill "$DOCKERD_PID" 2>/dev/null || true
wait "$DOCKERD_PID" 2>/dev/null || true
