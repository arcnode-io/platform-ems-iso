#!/bin/sh
# DISABLED BY DEFAULT — rename to .hook.chroot (drop .example) to enable.
#
# This hook downloads MinIO server + mc client binaries from min.io into
# the live chroot at build time. Pulling external binaries during an ISO
# build is intentionally a deliberate, user-acknowledged action.
#
# Before enabling:
#   1. Pick a pinned MinIO version (https://github.com/minio/minio/releases)
#   2. Confirm the checksum against the release notes
#   3. Add the chosen version to MINIO_VERSION below
#   4. Rename this file to 0030-install-minio.hook.chroot
#
# Operator-authored content the hook should run is intentionally left
# here as a TODO so the maintainer makes the choice explicitly.
set -e

echo "ERROR: 0030-install-minio is a template — pin MINIO_VERSION and rename to .hook.chroot"
exit 1

# TEMPLATE — uncomment + fill in after picking a version:
# MINIO_VERSION="RELEASE.YYYY-MM-DDTHH-MM-SSZ"
# MINIO_SHA256="<paste-from-release-notes>"
# curl -fsSL "https://dl.min.io/server/minio/release/linux-amd64/archive/minio.${MINIO_VERSION}" -o /usr/local/bin/minio
# echo "${MINIO_SHA256}  /usr/local/bin/minio" | sha256sum -c -
# chmod +x /usr/local/bin/minio
