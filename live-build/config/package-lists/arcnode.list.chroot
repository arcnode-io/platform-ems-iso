# Packages installed into the live chroot at build time.
# Order grouped by role; comments cite *why* each one belongs in the image.

# --- Base + boot ----------------------------------------------------
linux-image-amd64
firmware-linux
live-boot
live-config
systemd-sysv
openssh-server
ca-certificates
curl
gnupg
sudo
apt-transport-https

# --- Data daemons ---------------------------------------------------
# Bookworm ships postgresql-15 as default; timescale + pgvector for 15
# exist in their respective third-party repos. neo4j from neo4j's repo.
postgresql-15
postgresql-15-pgvector
timescaledb-2-postgresql-15
neo4j

# --- Container runtime ----------------------------------------------
# docker.io from debian (smaller than docker-ce, no third-party repo).
# Compose v2 is installed via hook 0045 (no debian package in bookworm).
docker.io

# --- App-stack runtime helpers --------------------------------------
python3
python3-venv
# uv installed via hook (no debian package yet)

# --- Optional but useful diagnostics --------------------------------
htop
iotop
lsof
tcpdump
