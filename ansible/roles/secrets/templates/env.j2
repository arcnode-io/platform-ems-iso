# Generated by the ARCNODE secrets role. DO NOT commit. Compose interpolates
# ${VAR} from this file; app services also receive them as container env.
SITE_ID={{ site_id | default('arcnode-appliance') }}

# --- persistence (local containers; same env contract as managed cloud) ---
PG_TS_PW={{ pg_ts_pw }}
PG_DOC_PW={{ pg_doc_pw }}
TIMESERIES_URL=postgresql://arcnode:{{ pg_ts_pw }}@postgres-timeseries:5432/timeseries
DOCUMENT_URL=postgresql://arcnode:{{ pg_doc_pw }}@postgres-document:5432/document

# --- broker File-RBAC machine passwords (mirror credentials.xml) ---
MQTT_GATEWAY_PASSWORD={{ mqtt_gateway_pw }}
MQTT_OPERATOR_PASSWORD={{ mqtt_operator_pw }}
MQTT_VIEWER_PASSWORD={{ mqtt_viewer_pw }}
MQTT_DEVICE_API_PASSWORD={{ mqtt_device_api_pw }}
MQTT_TELEMETRY_WRITER_PASSWORD={{ mqtt_telemetry_writer_pw }}

# --- device-api auth (issues JWTs; verifies operator/viewer logins) ---
AUTH_JWT_SECRET={{ auth_jwt_secret }}
AUTH_OPERATOR_PW={{ auth_operator_pw }}
AUTH_VIEWER_PW={{ auth_viewer_pw }}

# Airgap: no vendor chat/embed keys (Ollama per ADR-024). OpenWeatherMap
# unreachable airgapped → left blank; weather features degrade gracefully.
OPENWEATHERMAP_API_KEY=
