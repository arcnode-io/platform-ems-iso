#!/bin/sh
# DEBUG ONLY — drops the dev's SSH key into root's authorized_keys so
# the test-bench iteration loop works without password-auth gymnastics.
# Pair with hook 0005-debug-root-pw (root:demo). Both removed before
# customer ship.
set -e

mkdir -p /root/.ssh
chmod 700 /root/.ssh
cat > /root/.ssh/authorized_keys <<'EOF'
ssh-rsa  resister@thinkpad
EOF
chmod 600 /root/.ssh/authorized_keys
