#!/bin/sh
# debian live-build config — invoked by `lb config`.
# Produces a hybrid (USB-flashable + DVD-bootable) installer ISO based on
# Debian Bookworm amd64. The installer step uses Debian's stock d-i; our
# wizard runs as a systemd service after first boot.
set -e

lb config noauto \
  --architectures amd64 \
  --distribution bookworm \
  --debian-installer live \
  --debian-installer-gui false \
  --archive-areas "main contrib non-free non-free-firmware" \
  --bootloader "grub-efi grub-pc" \
  --binary-images iso-hybrid \
  --image-name arcnode-ems \
  --iso-application "ARCNODE EMS Appliance" \
  --iso-publisher "arcnode.io" \
  --iso-volume "ARCNODE-EMS" \
  --bootappend-live "boot=live components quiet splash console=tty0 console=ttyS0,115200n8" \
  --linux-flavours amd64 \
  --memtest none \
  --apt-recommends false \
  "${@}"

# Seed ca-certificates into the debootstrap phase so the chroot has a CA
# bundle in /etc/ssl/certs BEFORE apt-get update reaches the HTTPS-only
# third-party repos (debian.neo4j.com, packagecloud.io). The cli flag
# names for this vary across live-build versions (--bootstrap-include,
# --bootstrap-flags, --debootstrap-options); editing the generated
# config/bootstrap is version-agnostic.
if grep -q '^LB_BOOTSTRAP_INCLUDES=' config/bootstrap 2>/dev/null; then
  sed -i 's/^LB_BOOTSTRAP_INCLUDES=.*/LB_BOOTSTRAP_INCLUDES="ca-certificates"/' config/bootstrap
else
  echo 'LB_BOOTSTRAP_INCLUDES="ca-certificates"' >> config/bootstrap
fi

# Force LB_BOOTAPPEND_LIVE — `lb config --bootappend-live` doesn't always
# rewrite existing config/binary, so explicitly set it post-config. Adds
# console=ttyS0 so the kernel logs to both VGA and serial — required for
# our qemu integration test to capture boot diagnostics.
# Reason: `quiet splash` dropped — we need verbose systemd output to
# diagnose why arcnode-wizard isn't binding port 80 in the qemu test.
# Re-add once the wizard reliably comes up + the demo polish phase starts.
BOOTAPPEND="boot=live components console=tty0 console=ttyS0,115200n8 systemd.show_status=1"
if grep -q '^LB_BOOTAPPEND_LIVE=' config/binary 2>/dev/null; then
  sed -i "s|^LB_BOOTAPPEND_LIVE=.*|LB_BOOTAPPEND_LIVE=\"${BOOTAPPEND}\"|" config/binary
else
  echo "LB_BOOTAPPEND_LIVE=\"${BOOTAPPEND}\"" >> config/binary
fi
