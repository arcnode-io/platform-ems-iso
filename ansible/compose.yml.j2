# ARCNODE appliance stack. Step 2: one greeter, proves ansible -> compose ->
# container. DBs (Timescale/graph/vector) + broker + writer slot in as more
# services in later increments — same file, same self-converge.
services:
  greeter:
    image: nginx:alpine
    restart: unless-stopped
    ports:
      - "{{ http_port }}:80"
    volumes:
      - ./index.html:/usr/share/nginx/html/index.html:ro
