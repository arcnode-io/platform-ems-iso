#!/bin/sh
# Bake Ollama models into the ISO at build time so the appliance never
# has to phone home for a model on first inference. Operator chose:
# "back. duh." — models are baked, full stop.
#
# Trick: we can't `ollama serve` inside the chroot (no systemd, no init)
# but we CAN download model layers by running ollama in foreground briefly
# and pulling via the HTTP API once the bg process is healthy.
set -e

OLLAMA_MODELS=/opt/arcnode/ollama/models
mkdir -p "$OLLAMA_MODELS"
chown -R ollama:ollama "$OLLAMA_MODELS"

# Reason: same model set as the dev endpoint (173.211.12.43) per
# reference_arcnode_ollama_endpoint memory — chat, code, embed.
MODELS="qwen3:8b qwen3-coder:7b nomic-embed-text"

# Start ollama in background with our model dir
sudo -u ollama -E env OLLAMA_MODELS="$OLLAMA_MODELS" \
  /usr/local/bin/ollama serve >/tmp/ollama.log 2>&1 &
OLLAMA_PID=$!

# Wait for the API to come up — fail loud if it doesn't in 30s
for i in $(seq 1 30); do
  if curl -fsS http://127.0.0.1:11434/api/version >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

for model in $MODELS; do
  echo "==> pulling $model"
  curl -fsS -X POST http://127.0.0.1:11434/api/pull \
    -d "{\"name\":\"$model\",\"stream\":false}" >/dev/null
done

kill "$OLLAMA_PID" 2>/dev/null || true
wait "$OLLAMA_PID" 2>/dev/null || true

# Confirm the model dir has content
du -sh "$OLLAMA_MODELS"
