[Unit]
Description=Ollama local LLM runtime
Documentation=https://github.com/ollama/ollama
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=ollama
Group=ollama
# Models baked at ISO build time into /opt/arcnode/ollama/models — we set
# OLLAMA_MODELS so first request hits a warm cache, not a download.
Environment=OLLAMA_MODELS=/opt/arcnode/ollama/models
Environment=OLLAMA_HOST=127.0.0.1:11434
# Airgapped: silence the daemon's GitHub-release update probe + any
# usage telemetry. Daemon still runs cached models; just no egress.
Environment=OLLAMA_NOANALYTICS=1
ExecStart=/usr/local/bin/ollama serve
Restart=on-failure
RestartSec=5
# Reason: model loads can stall briefly; give the runtime room to recover
# without systemd flapping it.
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
