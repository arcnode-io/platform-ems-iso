[Unit]
Description=ARCNODE first-boot setup wizard
After=network-online.target
Wants=network-online.target
# Once the marker exists the wizard refuses anyway, but skip the unit
# entirely so port 80/443 stays free for nginx/Caddy on the HMI.
ConditionPathExists=!/var/lib/arcnode/setup-complete

[Service]
Type=exec
User=root
# Reason: root because we bind 80/443 + write to /etc/arcnode + /var/lib/arcnode.
# Wizard drops privileges via the apply pipeline — services in compose run as
# their own UIDs.
WorkingDirectory=/opt/arcnode/wizard
ExecStart=/opt/arcnode/wizard/.venv/bin/python -m src.main
EnvironmentFile=-/etc/arcnode/wizard.env
# Wizard apply schedules a clean SIGTERM 2s after returning the 200 to
# the operator. After that exit, kick arcnode-compose.service — only NOW
# is port 80 free for HMI to bind. ExecStopPost runs after process exit
# regardless of exit status, so this fires on the wizard's normal
# shutdown path too (harmless: compose has ConditionPathExists guard).
ExecStopPost=-/bin/systemctl start arcnode-compose.service
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
