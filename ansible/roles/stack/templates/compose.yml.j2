# ARCNODE appliance stack. Same topology as the commercial cloud compose, but
# persistence is LOCAL containers (airgap can't reach managed Tiger/Aurora) and
# the gateway's default DTM binds to on-box mock protocol servers (self-test).
# Service-name DNS on the default bridge network. Secrets come from .env.
#
# App services consume the WHOLE .env via env_file (proven commercial pattern) —
# never cherry-pick per-service env vars: device-api dispenses operator+viewer
# broker creds, so it needs every MQTT_*_PASSWORD, not just its own.
#
# Increment 1 = core telemetry path (gateway→mocks→broker→writer→timescale + HMI).
# analyst-server / ollama / minio / neo4j / observability layer in next.

x-restart: &restart
  restart: unless-stopped
x-appenv: &appenv
  env_file: [.env]

services:
  postgres-timeseries:
    <<: *restart
    image: timescale/timescaledb:2.17.2-pg16
    environment:
      POSTGRES_USER: arcnode
      POSTGRES_PASSWORD: ${PG_TS_PW}
      POSTGRES_DB: timeseries
    volumes:
      - ts-data:/var/lib/postgresql/data

  postgres-document:
    <<: *restart
    image: postgres:16.6
    environment:
      POSTGRES_USER: arcnode
      POSTGRES_PASSWORD: ${PG_DOC_PW}
      POSTGRES_DB: document
    volumes:
      - doc-data:/var/lib/postgresql/data
      # der-control-api's own database, created alongside `document` on first
      # boot — not a shared schema. See document-init.sql.
      - ./config/document-init.sql:/docker-entrypoint-initdb.d/01-dercontrol.sql:ro

  hivemq:
    # ems-hivemq: File-RBAC baked, Allow-All stripped → rejects anonymous,
    # enforces per-role topic ACL. credentials.xml bind-mounted from secrets role.
    <<: *restart
    image: public.ecr.aws/y1d2j6a8/ems-hivemq:latest
    volumes:
      - ./credentials.xml:/opt/hivemq/extensions/hivemq-file-rbac-extension/conf/credentials.xml:ro

  device-api:
    <<: [*restart, *appenv]
    image: public.ecr.aws/y1d2j6a8/ems-device-api:latest
    environment:
      ENV: beta
      BOOT_DTM_PATH: /app/dtm.json
      BROKER_URL: tcp://hivemq:1883
    volumes:
      - ./config/dtm.json:/app/dtm.json:ro
    healthcheck:
      test: ["CMD-SHELL", "node -e 'require(\"http\").get(\"http://localhost:3000/health\",r=>process.exit(r.statusCode<500?0:1)).on(\"error\",()=>process.exit(1))'"]
      interval: 10s
      timeout: 5s
      retries: 18
      start_period: 20s
    depends_on:
      hivemq: {condition: service_started}
      postgres-document: {condition: service_started}

  # IEEE 2030.5 / OpenADR DER control intake. Utility/aggregator POSTs
  # DERControl events → persists to its own database in postgres-document
  # (DER_CONTROL_URL, ddl-auto=update) → republishes setpoints as measurement
  # samples on the der_dispatch singleton device. No published port yet — the
  # utility-facing HTTPS side needs mutual TLS (own follow-up); same as cloud.
  der-control-api:
    <<: [*restart, *appenv]
    image: public.ecr.aws/y1d2j6a8/ems-der-control-api:latest
    environment:
      ENV: beta
    depends_on:
      hivemq: {condition: service_started}
      postgres-document: {condition: service_started}

  telemetry-writer:
    <<: [*restart, *appenv]
    image: public.ecr.aws/y1d2j6a8/ems-telemetry-writer:latest
    environment:
      BROKER: hivemq
    depends_on:
      hivemq: {condition: service_started}
      postgres-timeseries: {condition: service_started}

  mock-modbus-server:   {<<: *restart, image: "public.ecr.aws/y1d2j6a8/mock-modbus-server:latest"}
  mock-snmp-agent:      {<<: *restart, image: "public.ecr.aws/y1d2j6a8/mock-snmp-agent:latest"}
  mock-redfish-service: {<<: *restart, image: "public.ecr.aws/y1d2j6a8/mock-redfish-service:latest"}
  mock-dnp3-outstation: {<<: *restart, image: "public.ecr.aws/y1d2j6a8/mock-dnp3-outstation:latest"}
  mock-bacnet-device:   {<<: *restart, image: "public.ecr.aws/y1d2j6a8/mock-bacnet-device:latest"}

  industrial-gateway:
    <<: [*restart, *appenv]
    image: public.ecr.aws/y1d2j6a8/ems-industrial-gateway:latest
    environment:
      ENV: beta
      CFG_CUSTOMER_PATH: /app/cfg.customer.yml
    volumes:
      - ./config/gateway-cfg.customer.yml:/app/cfg.customer.yml:ro
    depends_on:
      hivemq: {condition: service_started}
      device-api: {condition: service_healthy}
      mock-modbus-server: {condition: service_started}
      mock-snmp-agent: {condition: service_started}
      mock-redfish-service: {condition: service_started}
      mock-dnp3-outstation: {condition: service_started}
      mock-bacnet-device: {condition: service_started}

  # ---- data layer for analyst (local; airgap can't use managed) ----
  postgres-vector:
    <<: *restart
    image: pgvector/pgvector:pg16
    environment:
      POSTGRES_USER: arcnode
      POSTGRES_PASSWORD: ${PG_VEC_PW}
      POSTGRES_DB: vector
    volumes:
      - vec-data:/var/lib/postgresql/data
      - ./config/vector-init.sql:/docker-entrypoint-initdb.d/01-vector.sql:ro

  neo4j:
    <<: *restart
    image: neo4j:5.26-community
    environment:
      NEO4J_AUTH: neo4j/${NEO4J_PW}
      # Default 512MB heap OOMs applying the full analyst graph seed.
      NEO4J_server_memory_heap_initial__size: 2G
      NEO4J_server_memory_heap_max__size: 4G
      NEO4J_server_memory_pagecache_size: 2G
    volumes:
      - neo4j-data:/data

  minio:
    <<: *restart
    image: minio/minio:RELEASE.2025-04-22T22-12-26Z
    command: server /data
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD}
    volumes:
      - minio-data:/data

  ollama:
    <<: *restart
    image: ollama/ollama:0.6.8
    volumes:
      - ollama-models:/root/.ollama

  analyst-server:
    <<: [*restart, *appenv]
    image: public.ecr.aws/y1d2j6a8/ems-analyst-server:latest
    environment:
      ENV: beta
      CFG_CUSTOMER_PATH: /app/cfg.customer.yml
      # The in-process agent calls the analyst-server's OWN api (measurements/
      # forecast) via SERVER_URL — self-referential on localhost.
      SERVER_URL: http://localhost:8000
    volumes:
      - ./config/analyst-cfg.customer.yml:/app/cfg.customer.yml:ro
    healthcheck:
      test: ["CMD-SHELL", "python3 -c 'import urllib.request,sys; sys.exit(0 if urllib.request.urlopen(\"http://localhost:8000/health\",timeout=3).status<500 else 1)'"]
      interval: 10s
      timeout: 5s
      retries: 60
      start_period: 300s   # first boot seeds the full graph dump (minutes); the
                           # mcp seed guard skips it on subsequent boots
    depends_on:
      postgres-vector: {condition: service_started}
      postgres-document: {condition: service_started}
      neo4j: {condition: service_started}
      ollama: {condition: service_started}

  hmi:
    <<: [*restart, *appenv]
    image: public.ecr.aws/y1d2j6a8/ems-hmi:latest
    volumes:
      - ./config/hmi-cfg.customer.yml:/opt/arcnode/hmi-cfg.customer.yml:ro
    depends_on:
      device-api: {condition: service_healthy}
      analyst-server: {condition: service_started}

  ingress:
    <<: *restart
    image: nginx:1.27-alpine
    ports:
      - "{{ http_port | default(80) }}:80"
      - "443:443"
    volumes:
      - ./tls:/etc/nginx/tls:ro
      - ./ingress.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      hmi: {condition: service_started}

volumes:
  ts-data:
  doc-data:
  vec-data:
  neo4j-data:
  minio-data:
  ollama-models:
