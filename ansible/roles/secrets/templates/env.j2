# Generated by the ARCNODE secrets role. DO NOT commit. Compose interpolates
# ${VAR} from this file; app services also receive them as container env.
SITE_ID={{ site_id | default('arcnode-appliance') }}

# --- persistence (local containers; same env contract as managed cloud) ---
PG_TS_PW={{ secrets_pg_ts_pw }}
PG_DOC_PW={{ secrets_pg_doc_pw }}
TIMESERIES_URL=postgresql://arcnode:{{ secrets_pg_ts_pw }}@postgres-timeseries:5432/timeseries
DOCUMENT_URL=postgresql://arcnode:{{ secrets_pg_doc_pw }}@postgres-document:5432/document
# der-control-api's own database in the same postgres-document container (not
# the document schema device-api owns) — schema-ownership isolation, mirrors
# the cloud's dedicated Aurora "dercontrol" slice. Created by document-init.sql.
DER_CONTROL_URL=postgresql://arcnode:{{ secrets_pg_doc_pw }}@postgres-document:5432/dercontrol
PG_VEC_PW={{ secrets_pg_vec_pw }}
VECTOR_URL=postgresql://arcnode:{{ secrets_pg_vec_pw }}@postgres-vector:5432/vector
NEO4J_PW={{ secrets_neo4j_pw }}
GRAPH_URL=bolt://neo4j:{{ secrets_neo4j_pw }}@neo4j:7687
MINIO_ROOT_USER=arcnode
MINIO_ROOT_PASSWORD={{ secrets_minio_pw }}

# --- broker File-RBAC machine passwords (mirror credentials.xml) ---
MQTT_GATEWAY_PASSWORD={{ secrets_mqtt_gateway_pw }}
MQTT_OPERATOR_PASSWORD={{ secrets_mqtt_operator_pw }}
MQTT_VIEWER_PASSWORD={{ secrets_mqtt_viewer_pw }}
MQTT_DEVICE_API_PASSWORD={{ secrets_mqtt_device_api_pw }}
MQTT_TELEMETRY_WRITER_PASSWORD={{ secrets_mqtt_telemetry_writer_pw }}
MQTT_DER_CONTROL_API_PASSWORD={{ secrets_mqtt_der_control_api_pw }}

# --- device-api auth (issues JWTs; verifies operator/viewer logins) ---
AUTH_JWT_SECRET={{ secrets_auth_jwt_secret }}
AUTH_OPERATOR_PW={{ secrets_auth_operator_pw }}
AUTH_VIEWER_PW={{ secrets_auth_viewer_pw }}

# Airgap: no vendor chat/embed keys (Ollama per ADR-024). OpenWeatherMap
# unreachable airgapped -> left blank; weather features degrade gracefully.
OPENWEATHERMAP_API_KEY=
