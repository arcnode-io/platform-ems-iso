#!/bin/sh
# Replace default /etc/issue with the ARCNODE first-boot banner.
# agetty interpolates \4 to the primary IPv4 before showing, so the
# operator sees the wizard URL with the actual IP.
#
# Runs in chroot phase, side-effect only — no daemons touched.
set -e

cat > /etc/issue <<'EOF'

  A   R   C   N   O   D   E
  ──────────────────────────────
  AI Energy Solutions

  First-boot setup — open a browser:

      http://\4/


EOF
chmod 0644 /etc/issue
