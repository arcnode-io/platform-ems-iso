#!/bin/sh
# Install the wizard FastAPI app into /opt/arcnode/wizard with uv-managed
# venv. Source comes from includes.chroot/opt/arcnode/wizard (copied by
# live-build before hooks run).
set -e

# Install uv (one binary, no python bootstrap needed)
curl -LsSf https://astral.sh/uv/install.sh | sh
mv /root/.local/bin/uv /usr/local/bin/uv

cd /opt/arcnode/wizard
# Reason: --frozen so we use the uv.lock from the repo, not whatever pypi
# resolves at build time. Reproducible builds.
uv sync --frozen --no-dev
