[Unit]
Description=Create pgvector extension in postgres-vector cluster (one-shot, first boot)
After=postgresql@15-vector.service
Requires=postgresql@15-vector.service
# Marker prevents re-running; safe to leave enabled forever.
ConditionPathExists=!/var/lib/arcnode/pgvector-installed

[Service]
Type=oneshot
RemainAfterExit=yes
User=postgres
ExecStart=/usr/bin/psql -h 127.0.0.1 -p 5435 -d postgres -c "CREATE EXTENSION IF NOT EXISTS vector"
# Drop the marker only on success — failed creates retry next boot.
ExecStartPost=/bin/sh -c "mkdir -p /var/lib/arcnode && touch /var/lib/arcnode/pgvector-installed"

[Install]
WantedBy=multi-user.target
