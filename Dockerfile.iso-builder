# Builder image for ARCNODE EMS live-build ISO.
#
# Why this exists: `lb build` mounts /proc inside its chroot, runs
# debootstrap as root, and chowns every file under chroot/, binary/,
# cache/, .build/ to root. Run on a shell-executor runner, that
# privilege escalation pollutes the workspace and blocks the NEXT
# pipeline's `git clone` from cleaning up.
#
# Inside a container, the privileged writes go to the container's
# writable layer in /var/lib/docker — not the host workspace. On
# `docker rm`, the layer (and the chroot) dies. Host workspace is
# never touched with root.
#
# The container needs --privileged for debootstrap's bind-mounts.
# That's a docker daemon capability, not a host filesystem write.
FROM debian:bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    live-build \
    xorriso \
    debootstrap \
    squashfs-tools \
    cpio \
    sudo \
    ca-certificates \
    file \
    curl \
    gzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
# CI populates live-build/config/includes.chroot/* BEFORE docker build.
# COPY picks up the populated tree at image-build time; the docker
# build context is the repo root.
COPY live-build/ ./live-build/

WORKDIR /build/live-build
# Single shell script so the container exits with lb build's status.
# Renames the produced ISO to /build/output.iso so the CI's
# `docker cp` doesn't need to glob (docker cp can't glob).
CMD ["sh", "-c", "set -e && lb clean --purge && lb config && lb build && mv arcnode-ems-*.iso /build/output.iso"]
