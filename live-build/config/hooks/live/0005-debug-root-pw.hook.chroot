#!/bin/sh
# DEBUG ONLY — set root password to "demo" so we can ssh/serial-login
# into the live VM during diagnostic boots. Remove before customer ship.
# Without this, live-config's default user/passwd combos all reject;
# something in our hook chain is interfering with live-config's normal
# password setup.
set -e
echo 'root:demo' | chpasswd
# Allow root login over ssh (default debian sshd denies root)
sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
